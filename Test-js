                    QUIZ RENDER
====================================================== */

function renderQuestion(){

    const questionNumber = current + 1;

    questionText.textContent = t("questions")[current];
    qCount.textContent = t("questionLabel")(questionNumber, TOTAL_QUESTIONS);

    const percent = Math.round((questionNumber / TOTAL_QUESTIONS) * 100);
    qPercent.textContent = `${percent}%`;
    progressFill.style.width = `${percent}%`;

    optionsList.innerHTML = "";

    t("options").forEach((label, index) => {

        const option = document.createElement("div");
        option.className = "option";
        if(answers[current] === index){ option.classList.add("selected"); }

        option.innerHTML = `
            <span class="option-radio"></span>
            <span class="option-label">${label}</span>
            <span class="option-check"><i data-lucide="check"></i></span>
        `;

        option.addEventListener("click", () => {
            answers[current] = index;
            renderQuestion();
        });

        optionsList.appendChild(option);

    });

    backBtn.disabled = current === 0;
    backBtn.style.visibility = current === 0 ? "hidden" : "visible";

    nextLabel.textContent = questionNumber === TOTAL_QUESTIONS ? t("finish") : t("next");
    nextBtn.disabled = answers[current] === null;

    refreshIcons();

}

nextBtn.addEventListener("click", () => {

    if(answers[current] === null){ return; }

    if(current === TOTAL_QUESTIONS - 1){
        goToAnalyzing();
        return;
    }

    current++;
    renderQuestion();

});

backBtn.addEventListener("click", () => {

    if(current === 0){ return; }

    current--;
    renderQuestion();

});

