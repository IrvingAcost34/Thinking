/* ======================================================
                    BOMBI INTRO (typing effect)
====================================================== */

let bombiTyped = false;
let bombiTypeTimer = null;

function renderBombiMessage(){

    const message = t("bombiMessage");

    if(!bombiTyped){

        typewriter(bombiMessage, message, 18);
        bombiTyped = true;

    }
    else{

        clearInterval(bombiTypeTimer);
        bombiMessage.textContent = message;

    }

}

function typewriter(el, text, speed){

    el.textContent = "";

    const cursor = document.createElement("span");
    cursor.className = "typing-cursor";
    el.appendChild(cursor);

    let i = 0;

    bombiTypeTimer = setInterval(() => {

        cursor.insertAdjacentText("beforebegin", text[i]);
        i++;

        if(i >= text.length){
            clearInterval(bombiTypeTimer);
            cursor.remove();
        }

    }, speed);

}

