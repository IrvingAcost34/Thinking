/* ======================================================
                    SAVE RESULTS (Supabase)
    Guarda una fila por cuenta en la tabla learning_results.
    Si el estudiante repite el test, se actualiza su fila.
====================================================== */

let resultsSaved = false;

async function saveResults(){

    if(resultsSaved){ return true; }

    if(!db){
        showToast(t("saveNoConnection"), "error");
        return false;
    }

    const sessionResult = await db.auth.getSession();
    const session = sessionResult.data ? sessionResult.data.session : null;

    if(sessionResult.error || !session){
        showToast(t("saveNotLoggedIn"), "error");
        return false;
    }

    const scores = calculateScores();
    const top = scores[0];

    const saveResult = await db.from("learning_results").upsert({
        user_id: session.user.id,
        answers: answers,
        scores: scores,
        top_style: top.key,
        top_percent: top.percent,
        lang: currentLang,
        updated_at: new Date().toISOString()
    }, { onConflict: "user_id" });

    if(saveResult.error){
        showToast(t("saveError") + " " + saveResult.error.message, "error");
        return false;
    }

    resultsSaved = true;
    showToast(t("saveOk"), "ok");
    return true;

}

function goToAnalyzing(){

    showScreen(screenAnalyzing);

    const minWait = new Promise((resolve) => setTimeout(resolve, 1800));

    Promise.all([saveResults(), minWait]).then(() => {
        computeResults();
        showScreen(screenResults);
        refreshIcons();
    });

}

/* ======================================================
                    RESULTS
====================================================== */

function calculateScores(){

    const scores = STYLE_BLOCKS.map((block) => {

        const [start, end] = block.range;
        const blockAnswers = answers.slice(start, end);
        const maxPerQuestion = t("options").length - 1; // 4
        const sum = blockAnswers.reduce((acc, val) => acc + (val ?? 0), 0);
        const max = blockAnswers.length * maxPerQuestion;
        const percent = max === 0 ? 0 : Math.round((sum / max) * 100);

        return { key: block.key, percent };

    });

    scores.sort((a, b) => b.percent - a.percent);

    return scores;

}

function computeResults(){

    const scores = calculateScores();

    const top = scores[0];
    const topInfo = t("styles")[top.key];

    resultStyleName.textContent = topInfo.name;
    resultStyleSub.textContent = topInfo.blurb;

    resultsRing.style.setProperty("--pct", top.percent);
    resultsRingPct.textContent = `${top.percent}%`;
    resultsRingLabel.textContent = topInfo.label;

    resultsBars.innerHTML = scores.slice(1).map((s) => {

        const info = t("styles")[s.key];

        return `
            <div class="results-bar-row">
                <span class="results-bar-label">${info.label}</span>
                <div class="results-bar-track">
                    <div class="results-bar-fill" style="width:${s.percent}%;"></div>
                </div>
                <span class="results-bar-pct">${s.percent}%</span>
            </div>
        `;

    }).join("");

    techniquesList.innerHTML = topInfo.techniques.map((tech) => `
        <div class="technique-item">
            <i data-lucide="${tech.icon}"></i>
            <span>${tech.label}</span>
        </div>
    `).join("");

}

